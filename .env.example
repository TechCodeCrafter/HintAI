# Copy this file to .env (gitignored). Do not commit keys.
# Search does not use these. OPENAI_API_KEY is for the spoken demo voices.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Optional. Logs LLM prompt sizes in the browser/server console.
# VITE_DEBUG_LLM=true

# Optional. Hosted folder for landing mp4s (no trailing slash).
# Dev uses /demo from disk. Production defaults to the pinned CDN copy.
# VITE_DEMO_MEDIA_BASE=https://cdn.jsdelivr.net/gh/TechCodeCrafter/HintAI@ba30b35/public/demo
