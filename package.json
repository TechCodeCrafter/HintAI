{
  "name": "meethint",
  "description": "MeetHint — cite or silence. Live meeting copilot that cites your loaded files or stays silent.",
  "homepage": "https://meethint.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/TechCodeCrafter/HintAI.git"
  },
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "build": "node scripts/copy-demo-media.mjs && node scripts/with-app-env.mjs vite build && node scripts/copy-pglite-assets.mjs && node scripts/fix-ssr-bundle.mjs && npm run db:migrate",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "preview:e2e": "node scripts/with-app-env.mjs vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "check:auth": "node scripts/check-auth-invariant.mjs",
    "test": "node scripts/run-tests.mjs",
    "setup:githooks": "node scripts/enable-githooks.mjs",
    "check:cursor-attribution": "node scripts/check-cursor-attribution.mjs",
    "check:branch-fresh": "node scripts/check-branch-fresh.mjs",
    "verify:production-deploy": "node scripts/verify-production-deploy.mjs",
    "bisect:hydration": "node scripts/bisect-hydration.mjs",
    "verify:domain-email": "node scripts/verify-domain-email.mjs",
    "publish:mail-contacts": "node scripts/publish-mail-contacts.mjs",
    "test:e2e": "playwright test",
    "design:detect": "node scripts/design-detect.mjs",
    "test:e2e:ui": "playwright test --ui",
    "qa": "node scripts/ground-qa.mjs",
    "score": "node scripts/make-score.mjs",
    "voice": "node scripts/make-voice.mjs",
    "video:studio": "npm run score && remotion studio src/remotion/index.ts",
    "video:still": "remotion still src/remotion/index.ts Demo",
    "video:render": "npm run score && remotion render src/remotion/index.ts Demo public/demo/meethint-demo.mp4",
    "video:render:social": "remotion render src/remotion/index.ts Social public/demo/meethint-demo-social.mp4",
    "video:render:square": "remotion render src/remotion/index.ts Square public/demo/meethint-demo-square.mp4",
    "video:render:vo": "npm run score && remotion render src/remotion/index.ts Demo public/demo/meethint-demo.mp4 --props='{\"narration\":\"vo.mp3\"}'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sync:github": "node scripts/sync-github-repo.mjs",
    "flight:summary": "node scripts/flight-summary.mjs",
    "flight:analyze": "node scripts/flight-analyze.mjs",
    "flight:capture": "node --env-file=.env --experimental-strip-types scripts/capture-flight-session.mjs",
    "flight:validate": "node scripts/flight-analyze.mjs -- --compare fixtures/flight-sessions/real-session-latest.json",
    "beta:quality-report": "node --experimental-strip-types scripts/beta-quality-report.mjs",
    "beta:gates": "node --experimental-strip-types scripts/beta-gates.mjs",
    "generate:og": "node scripts/generate-meethint-og.mjs",
    "generate:og:legacy": "node scripts/generate-og-card.mjs",
    "latency:benchmark": "node scripts/latency-benchmark.mjs",
    "redteam:smoke": "node --experimental-strip-types --test src/lib/security/__tests__/redteam-harness.test.ts",
    "redteam:harness": "node scripts/redteam-harness.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@mdgate/ppt": "^0.6.25",
    "@ricky0123/vad-web": "^0.0.30",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/router-plugin": "^1.168.0",
    "better-auth": "~1.6.30",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.5",
    "fflate": "^0.8.3",
    "jose": "6.2.9",
    "kysely": "^0.28.5",
    "lucide-react": "^0.510.0",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "read-excel-file": "^5.8.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.4",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.62.1",
    "@remotion/cli": "^4.0.518",
    "@remotion/google-fonts": "^4.0.518",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "lightningcss": "^1.28.0",
    "nitro": "3.0.260610-beta",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "remotion": "^4.0.518",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0"
  }
}
