          "text": "trace if necessary."
        },
        {
          "kind": "paragraph",
          "regionId": "tracemonkey.pdf:p4:region:3",
          "parent": null,
          "lines": 1,
          "mapped": true,
          "text": "All LIR primitives apply to operands of specific types. Thus,"
        },
        {
          "kind": "paragraph",
          "regionId": "tracemonkey.pdf:p4:region:0",
          "parent": null,
          "lines": 2,
          "mapped": true,
          "text": "ate on unboxed values in simple variables and arrays as much as possible."
        }
      ]
