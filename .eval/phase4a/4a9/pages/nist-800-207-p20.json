      "str": "enterprise user accounts and identity records (e.g., lightweight directory access protocol",
      "x": 108,
      "y": 616.98,
      "width": 421.48,
      "height": 12,
      "right": 529.48,
      "visualLineId": 7,
      "inferredColumn": null
    },
    {
      "itemIndex": 27,
      "str": "(LDAP) server). This system contains the necessary subject information (e.g., name,",
      "x": 108,
      "y": 603.18,
      "width": 405.54,
      "height": 12,
      "right": 513.54,
      "visualLineId": 8,
      "inferredColumn": null
    },
    {
