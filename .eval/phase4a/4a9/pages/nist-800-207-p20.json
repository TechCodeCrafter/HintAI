      "width": 432.81,
      "height": 12,
      "right": 504.81,
      "visualLineId": 35,
      "inferredColumn": null
    },
    {
      "itemIndex": 72,
      "str": "calculation (and ultimate access authorization) or tailor the result in some way, such as granting",
      "x": 72,
