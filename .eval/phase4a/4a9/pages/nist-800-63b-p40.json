      "x": 72,
      "y": 482.64,
      "width": 0,
      "height": 0,
      "right": 76,
      "visualLineId": null,
      "inferredColumn": null
    },
    {
      "itemIndex": 33,
      "str": "In situations where the verifier and CSP are separate entities (as shown by the dotted line in",
      "x": 72,
      "y": 482.64,
      "width": 439.92,
      "height": 12,
      "right": 511.92,
      "visualLineId": 15,
      "inferredColumn": null
    },
    {
