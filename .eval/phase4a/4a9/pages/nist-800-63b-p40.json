    {
      "itemIndex": 9,
      "str": "",
      "x": 72,
      "y": 708.96,
      "width": 0,
      "height": 0,
      "right": 76,
      "visualLineId": null,
      "inferredColumn": null
    },
    {
      "itemIndex": 10,
      "str": "Approved cryptographic algorithms SHALL be used to establish verifier impersonation",
      "x": 72,
      "y": 708.96,
      "width": 420.48,
      "height": 12,
      "right": 492.48,
      "visualLineId": 2,
      "inferredColumn": null
    },
    {
      "itemIndex": 11,
      "str": "resistance where it is required. Keys used for this purpose SHALL provide at least the minimum",
      "x": 72,
      "y": 695.28,
      "width": 462.7,
      "height": 12,
      "right": 534.7,
      "visualLineId": 3,
      "inferredColumn": null
    },
    {
      "itemIndex": 12,
      "str": "security strength specified in the latest revision of",
      "x": 72,
      "y": 681.36,
      "width": 238.96,
      "height": 12,
      "right": 310.96,
      "visualLineId": 4,
      "inferredColumn": null
    },
    {
      "itemIndex": 13,
      "str": " ",
      "x": 310.96,
      "y": 681.36,
      "width": 0.25,
      "height": 0,
      "right": 311.2,
      "visualLineId": 4,
      "inferredColumn": null
    },
    {
      "itemIndex": 14,
