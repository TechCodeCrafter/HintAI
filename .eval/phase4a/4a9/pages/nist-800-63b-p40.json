      "width": 13.39,
      "height": 12,
      "right": 528.19,
      "visualLineId": 15,
      "inferredColumn": null
    },
    {
      "itemIndex": 36,
      "str": "800-63-3",
      "x": 72,
      "y": 468.96,
      "width": 43.68,
      "height": 12,
      "right": 115.68,
      "visualLineId": 16,
