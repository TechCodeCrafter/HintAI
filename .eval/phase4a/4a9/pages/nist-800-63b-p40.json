      "visualLineId": 4,
      "inferredColumn": null
    },
    {
      "itemIndex": 16,
      "str": "(112 bits as of the date of this",
      "x": 382.08,
      "y": 681.36,
      "width": 142.43,
      "height": 12,
      "right": 524.51,
      "visualLineId": 4,
